# Directories for big things like SNOMED CT that we don't want version controlled in Git
# Shared for all codespaces form this repository
/shared-not-stored-in-git/
# Unique for each codespace
/personal-not-stored-in-git/

# SNOMED CT RF2 archives are imported locally and must not be committed
/snomed-ct/**/*.zip

# Deno
# https://deno.com/
# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

# Java build output (Rust also uses /target)
*.class
target/
build/
.gradle/
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
